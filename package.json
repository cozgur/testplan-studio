{
  "name": "testplan-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Paste a URL or describe an app. Get a risk-based test plan, Playwright specs that pass a guardrail lint, and a one-click run on GitHub Actions. Static site, bring your own Claude API key.",
  "keywords": [
    "test-planning",
    "playwright",
    "claude",
    "sdet",
    "quality-engineering",
    "risk-based-testing",
    "agentic-testing"
  ],
  "author": "Özgür Çetintaş (https://github.com/cozgur)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cozgur/testplan-studio.git"
  },
  "homepage": "https://cozgur.github.io/testplan-studio/",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:runner": "playwright test -c runner/playwright.config.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:unit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.125.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
